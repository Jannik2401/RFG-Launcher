                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12" Background="{StaticResource GhostSurface}" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon}" Data="M1.6,2.6 L14.4,2.6 L14.4,13.4 L1.6,13.4 Z M4.6,6.2 L6.8,8.2 L4.6,10.2 M8.6,10.6 L12,10.6" Width="20" Height="20" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Launcher-Daten" Style="{StaticResource Text.H2}" />
                                        <TextBlock Text="Installationsordner und Absturzprotokolle." Style="{StaticResource Text.Caption}" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="4" Content="Öffnen" Style="{StaticResource SecondaryButton}"
                                            Click="OpenLogFolderButton_Click" Height="38" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================
             ACCOUNT SETTINGS DIALOG
             ============================================================ -->
        <Border x:Name="AccountSettingsPanel"
                Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource Scrim}"
                Visibility="Collapsed"
                Panel.ZIndex="50">
            <Border Background="{StaticResource Elevated}"
                    BorderBrush="{StaticResource BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="390"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="44" ShadowDepth="12" Opacity="0.6" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="Account Einstellungen" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource QuietButton}" Click="InlineCancelButton_Click"
                                Content="Schließen" HorizontalAlignment="Right" Padding="10,5" />
                    </Grid>

                    <TextBlock Text="BENUTZERNAME" Style="{StaticResource Text.FieldLabel}" />
                    <TextBlock x:Name="InlineTxtLoginUsername" Text="" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="ANZEIGENAME" Style="{StaticResource Text.FieldLabel}" />
                    <TextBox x:Name="InlineTxtDisplayName" Style="{StaticResource ModernTextBox}" Height="40" Margin="0,0,0,16" />

                    <TextBlock Text="PASSWORT" Style="{StaticResource Text.FieldLabel}" />
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="InlinePwdBox" PasswordChanged="InlinePwdBox_PasswordChanged"
                                     Style="{StaticResource ModernPasswordBox}" Height="40" Padding="13,10,66,10" />
                        <TextBox x:Name="InlineTxtVisiblePassword" TextChanged="InlineTxtVisiblePassword_TextChanged"
                                 Style="{StaticResource ModernTextBox}" Height="40" Padding="13,10,66,10" Visibility="Collapsed" />
                        <Button x:Name="InlineBtnTogglePwd" Content="Show" Style="{StaticResource RevealButton}"
                                Click="InlineBtnTogglePwd_Click" Width="60" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Abbrechen" Style="{StaticResource SecondaryButton}"
                                Click="InlineCancelButton_Click" Height="40" />
                        <Button Grid.Column="2" Content="Speichern" Style="{StaticResource SuccessButton}"
                                Click="InlineSaveButton_Click" Height="40" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
