<Window x:Class="BetaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFG Beta Launcher" Height="650" Width="1000"
        Background="#0F172A"
        Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Standard Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Border Background="#1E293B" Grid.Column="0">
            <StackPanel Margin="15">
                <TextBlock Text="RFG Launcher" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <Button Content="Home" Style="{StaticResource ActionButtonStyle}" Click="HomeButton_Click" Margin="0,5"/>
                <Button Content="Updates" Style="{StaticResource ActionButtonStyle}" Click="UpdatesButton_Click" Margin="0,5"/>
                <Button Content="Account" Style="{StaticResource ActionButtonStyle}" Click="AccountButton_Click" Margin="0,5"/>
                <Button x:Name="AdminMenuButton" Content="Admin" Style="{StaticResource ActionButtonStyle}" Click="AdminButton_Click" Margin="0,5" Visibility="Collapsed"/>
                <Button Content="Performance" Style="{StaticResource ActionButtonStyle}" Click="PerformanceButton_Click" Margin="0,5"/>
                <Button Content="Credits" Style="{StaticResource ActionButtonStyle}" Click="CreditsButton_Click" Margin="0,5"/>
                <Button Content="Settings" Style="{StaticResource ActionButtonStyle}" Click="SettingsButton_Click" Margin="0,5"/>
                
                <Separator Background="#334155" Margin="0,20"/>
                
                <TextBlock x:Name="LauncherVersionText" Text="Version: 1.0.0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="LauncherUpdateStatusText" Text="" FontSize="11" Foreground="#10B981" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <Button x:Name="CheckLauncherUpdateButton" Content="Update prüfen" Style="{StaticResource ActionButtonStyle}" Click="CheckLauncherUpdateButton_Click" FontSize="11" Margin="0,5"/>
                
                <Button Content="Beenden" Style="{StaticResource ActionButtonStyle}" Click="ExitButton_Click" Margin="0,20,0,0" Background="#991B1B"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            
            <!-- Top Corner User Profile / Login trigger -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Panel.ZIndex="10">
                <Button x:Name="AccountMenuButton" Content="Anmelden" Style="{StaticResource ActionButtonStyle}" Click="AccountButton_Click"/>
                
                <Border x:Name="UserProfileCornerBox" Background="#1E293B" CornerRadius="6" Padding="10,6" Cursor="Hand" MouseLeftButtonDown="UserProfileCornerBox_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CornerUsernameText" Text="Username" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="CornerRoleText" Text="Rolle: USER" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- HOME PAGE -->
            <Grid x:Name="HomePage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <TextBlock Text="Realistic Funfair Games" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Spielstatus" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,5"/>
                            <TextBlock x:Name="HomeVersionText" Text="Version wird geladen..." Margin="0,0,0,5"/>
                            <TextBlock x:Name="HomeStatusText" Text="PRÜFE..." FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Beta-Zugriff" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,5"/>
                            <TextBlock x:Name="HomeBetaAccessText" Text="PRÜFE..." FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    
                    <Button x:Name="StartButton" Content="SPIEL STARTEN" Style="{StaticResource ActionButtonStyle}" Click="StartButton_Click" Height="40" Background="#10B981" FontWeight="Bold" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <!-- UPDATES PAGE -->
            <Grid x:Name="UpdatesPage" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <TextBlock Text="Updates &amp; News" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock x:Name="StatusText" Text="Bereit." Foreground="#38BDF8" Margin="0,0,0,10"/>
                    
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Text="Installiert: -" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="Release Notes:" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,5"/>
                            <ScrollViewer Height="150">
                                <TextBlock x:Name="ReleaseNotesText" Text="Keine Notes vorhanden." TextWrapping="Wrap" Foreground="#94A3B8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    
                    <ProgressBar x:Name="Progress" Height="15" Margin="0,0,0,10" Maximum="100" Value="0"/>
                    <Button x:Name="UpdateButton" Content="Spiel herunterladen / aktualisieren" Style="{StaticResource ActionButtonStyle}" Click="UpdateButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ACCOUNT PAGE -->
            <Grid x:Name="AccountPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
                    <TextBlock Text="Account Login" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <!-- Login Panel -->
                    <StackPanel x:Name="AccountLoginPanel">
                        <TextBlock Text="Benutzername" Margin="0,0,0,5"/>
                        <TextBox x:Name="AccountUsernameTextBox" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Passwort" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <PasswordBox x:Name="AccountPasswordBox" PasswordChanged="AccountPasswordBox_PasswordChanged" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0"/>
                            <TextBox x:Name="AccountPasswordVisibleTextBox" TextChanged="AccountPasswordVisibleTextBox_TextChanged" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Visibility="Collapsed"/>
                            <Button x:Name="TogglePasswordBtn" Content="Show" HorizontalAlignment="Right" Width="50" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="TogglePasswordVisibility_Click" Cursor="Hand"/>
                        </Grid>
                        
                        <TextBlock x:Name="AccountStatusText" Text="" Foreground="#E11D48" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Button x:Name="AccountLoginButton" Content="Anmelden" Style="{StaticResource ActionButtonStyle}" Click="LoginAccountButton_Click"/>
                    </StackPanel>

                    <!-- Profile Panel -->
                    <StackPanel x:Name="AccountProfilePanel" Visibility="Collapsed">
                        <TextBlock Text="Eingeloggt als:" Foreground="#94A3B8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="ProfileUsernameDisplay" Text="Username" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Anzeigename ändern:" Margin="0,0,0,5"/>
                        <TextBox x:Name="NewDisplayNameTextBox" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,0,10"/>
                        <Button Content="Anzeigename speichern" Style="{StaticResource ActionButtonStyle}" Click="SaveDisplayNameButton_Click" Margin="0,0,0,15"/>
                        
                        <Button Content="Passwort ändern" Style="{StaticResource ActionButtonStyle}" Click="GoToChangePassword_Click" Margin="0,0,0,15"/>
                        <Button Content="Abmelden" Style="{StaticResource ActionButtonStyle}" Click="LogoutButton_Click" Background="#991B1B"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- CHANGE PASSWORD PAGE -->
            <Grid x:Name="ChangePasswordPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
                    <TextBlock Text="Passwort ändern" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Neues Passwort" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="NewPasswordBox" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Passwort bestätigen" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="ChangePasswordStatusText" Text="" Foreground="#E11D48" Margin="0,0,0,10"/>
                    <Button Content="Passwort speichern" Style="{StaticResource ActionButtonStyle}" Click="SaveNewPasswordButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ADMIN PAGE -->
            <Grid x:Name="AdminPage" Visibility="Collapsed">
                <StackPanel Margin="10">
                    <TextBlock Text="Admin Panel" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock x:Name="AdminActionStatus" Text="" Foreground="#38BDF8" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="AdminNewUsernameBox" Width="130" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,10,0"/>
                        <TextBox x:Name="AdminNewTempPassBox" Width="130" Padding="6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,10,0"/>
                        <ComboBox x:Name="AdminRoleComboBox" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="User" IsSelected="True"/>
                            <ComboBoxItem Content="Admin"/>
                        </ComboBox>
                        <Button Content="Benutzer erstellen" Style="{StaticResource ActionButtonStyle}" Click="AdminCreateUser_Click"/>
                    </StackPanel>

                    <!-- Scrollbare Liste mit Benutzerkarten und farbcodierten Statusanzeigen -->
                    <ScrollViewer Height="430" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="UsersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Benutzername & Rolle -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="#38BDF8"/>
                                            </StackPanel>

                                            <!-- Status-Anzeigen (Dynamisch eingefärbt) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BetaText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BetaColor}"/>
                                                <TextBlock Text="{Binding LockText}" FontSize="11" FontWeight="Bold" Foreground="{Binding LockColor}"/>
                                            </StackPanel>

                                            <!-- Aktions-Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Beta umschalten" Style="{StaticResource ActionButtonStyle}" Click="AdminToggleBeta_Click" Margin="4,0" FontSize="11"/>
                                                <Button Content="Passwort Reset" Style="{StaticResource ActionButtonStyle}" Click="AdminResetPw_Click" Margin="4,0" FontSize="11"/>
                                                <Button Content="Sperren" Style="{StaticResource ActionButtonStyle}" Click="AdminToggleLock_Click" Margin="4,0" FontSize="11" Background="#B45309"/>
                                                <Button Content="Löschen" Style="{StaticResource ActionButtonStyle}" Click="AdminDeleteUser_Click" Margin="4,0" FontSize="11" Background="#991B1B"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- PERFORMANCE PAGE -->
            <Grid x:Name="PerformancePage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                    <TextBlock Text="System Performance" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CpuText" Text="CPU: --" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock x:Name="RamText" Text="RAM: --" FontSize="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- CREDITS PAGE -->
            <Grid x:Name="CreditsPage" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                    
                    <TextBlock Text="Credits &amp; Social Media" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="3D Modellierer" FontSize="13" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Greentiger, Blaubeerteilchen, Felixgame21, TimmyPro" FontSize="15" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,15" TextAlignment="Center" TextWrapping="Wrap"/>

                            <TextBlock Text="Scripter" FontSize="13" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Crazyfunworld_Jannik, Blaubeerteilchen, Dennys" FontSize="15" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,15" TextAlignment="Center" TextWrapping="Wrap"/>

                            <TextBlock Text="Beta Tester" FontSize="13" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Elias_2x9" FontSize="15" Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Discord" Style="{StaticResource ActionButtonStyle}" Click="DiscordButton_Click" Margin="4"/>
                        <Button Content="Twitch" Style="{StaticResource ActionButtonStyle}" Click="TwitchButton_Click" Margin="4"/>
                        <Button Content="Instagram" Style="{StaticResource ActionButtonStyle}" Click="InstagramButton_Click" Margin="4"/>
                        <Button Content="TikTok" Style="{StaticResource ActionButtonStyle}" Click="TikTokButton_Click" Margin="4"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- SETTINGS PAGE -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                    <TextBlock Text="Einstellungen" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Keine Optionen verfügbar." HorizontalAlignment="Center" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>

            <!-- Inline Account Settings Overlay Panel -->
            <Border x:Name="AccountSettingsPanel" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="20">
                <Border Background="#1E293B" CornerRadius="8" Padding="20" Width="350" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Account Einstellungen" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBlock Text="Benutzername:" FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock x:Name="InlineTxtLoginUsername" Text="" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Anzeigename:" FontSize="12" Foreground="#94A3B8"/>
                        <TextBox x:Name="InlineTxtDisplayName" Padding="4" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Passwort:" FontSize="12" Foreground="#94A3B8"/>
                        <Grid Margin="0,0,0,15">
                            <PasswordBox x:Name="InlinePwdBox" PasswordChanged="InlinePwdBox_PasswordChanged" Padding="4" Background="#334155" Foreground="#F8FAFC" BorderThickness="0"/>
                            <TextBox x:Name="InlineTxtVisiblePassword" TextChanged="InlineTxtVisiblePassword_TextChanged" Padding="4" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Visibility="Collapsed"/>
                            <Button x:Name="InlineBtnTogglePwd" Content="Show" HorizontalAlignment="Right" Width="45" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="InlineBtnTogglePwd_Click" Cursor="Hand"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Abbrechen" Style="{StaticResource ActionButtonStyle}" Click="InlineCancelButton_Click" Margin="0,0,10,0" Background="#334155"/>
                            <Button Content="Speichern" Style="{StaticResource ActionButtonStyle}" Click="InlineSaveButton_Click" Background="#10B981"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Grid>
</Window>
