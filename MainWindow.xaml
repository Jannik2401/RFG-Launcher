<Window x:Class="BetaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RFG Beta Launcher"
        Height="720" Width="1080" MinHeight="600" MinWidth="940"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- ============================================================
         ANIMATED BACKDROP DRIVERS
         Each blob drifts on its own prime-ish period (17/19/23/29 s) so the
         motion never visibly repeats, plus a slower opacity "breathing"
         pass. Durations are deliberately coprime: the whole cycle only
         repeats after hours.
         ============================================================ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard x:Name="BackdropStoryboard">
                <Storyboard>
                    <!-- the backdrop itself fades in as soon as the window opens -->
                    <DoubleAnimation Storyboard.TargetName="Backdrop"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.7" BeginTime="0:0:0" />

                    <DoubleAnimation Storyboard.TargetName="AuroraCyanMove" Storyboard.TargetProperty="X"
                                     From="0" To="150" Duration="0:0:17" BeginTime="0:0:0"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="AuroraCyanMove" Storyboard.TargetProperty="Y"
                                     From="0" To="105" Duration="0:0:23" BeginTime="0:0:0"
                                     AutoReverse="True" RepeatBehavior="Forever" />

                    <DoubleAnimation Storyboard.TargetName="AuroraVioletMove" Storyboard.TargetProperty="X"
                                     From="0" To="-175" Duration="0:0:19" BeginTime="0:0:1.5"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="AuroraVioletMove" Storyboard.TargetProperty="Y"
                                     From="0" To="120" Duration="0:0:29" BeginTime="0:0:1.5"
                                     AutoReverse="True" RepeatBehavior="Forever" />

                    <DoubleAnimation Storyboard.TargetName="AuroraMagentaMove" Storyboard.TargetProperty="X"
                                     From="-90" To="110" Duration="0:0:29" BeginTime="0:0:3"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="AuroraMagentaMove" Storyboard.TargetProperty="Y"
                                     From="0" To="150" Duration="0:0:19" BeginTime="0:0:3"
                                     AutoReverse="True" RepeatBehavior="Forever" />

                    <DoubleAnimation Storyboard.TargetName="AuroraBlueMove" Storyboard.TargetProperty="X"
                                     From="-70" To="130" Duration="0:0:23" BeginTime="0:0:4.5"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="AuroraBlueMove" Storyboard.TargetProperty="Y"
                                     From="0" To="-95" Duration="0:0:17" BeginTime="0:0:4.5"
                                     AutoReverse="True" RepeatBehavior="Forever" />

                    <!-- breathing -->
                    <DoubleAnimation Storyboard.TargetName="AuroraCyanBlob" Storyboard.TargetProperty="Opacity"
                                     From="0.55" To="1" Duration="0:0:13" BeginTime="0:0:0"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="AuroraVioletBlob" Storyboard.TargetProperty="Opacity"
                                     From="0.6" To="1" Duration="0:0:17" BeginTime="0:0:2"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="AuroraMagentaBlob" Storyboard.TargetProperty="Opacity"
                                     From="0.3" To="0.8" Duration="0:0:19" BeginTime="0:0:4"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="AuroraBlueBlob" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="0.7" Duration="0:0:23" BeginTime="0:0:6"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             TITLE BAR  (top 48px is a native caption region: drag, snap,
             double-click maximize all work; only the buttons below opt out)
             ============================================================ -->
        <Grid x:Name="TitleBarRoot" Grid.Row="0" Background="{StaticResource ChromeBackground}" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Height="26" Stretch="Uniform" VerticalAlignment="Center"
                       AutomationProperties.Name="RFG Logo" />
                <TextBlock Text="RFG" Margin="11,0,0,0" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <Border Width="1" Height="14" Margin="9,0,9,0" Background="{StaticResource BorderStrong}" VerticalAlignment="Center" />
                <TextBlock Text="Launcher" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="Kirmes  ·  Beta"
                       FontSize="12.5"
                       Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimieren" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimieren">
                    <Path Style="{StaticResource CaptionIcon}" Data="M1,5 L9,5" />
                </Button>

                <Button Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximieren" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximieren">
                    <Grid>
                        <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionIcon}" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
                        <Path x:Name="RestoreGlyph" Style="{StaticResource CaptionIcon}" Data="M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z M2.5,2.5 L2.5,0.5 L9.5,0.5 L9.5,7.5 L7.5,7.5" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="CloseCaptionButton" AutomationProperties.Name="Schließen" Style="{StaticResource CaptionButtonClose}" Click="ExitButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Schließen">
                    <Path Style="{StaticResource CaptionIcon}" Data="M1,1 L9,9 M9,1 L1,9" />
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderSoft}" />
        </Grid>

        <!-- ============================================================
             SHELL
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border x:Name="SidebarRoot" Grid.Column="0" Background="{StaticResource ChromeBackground}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,1,0" Opacity="0">
                <Grid Margin="16,18,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Account area -->
                    <Grid Grid.Row="0">
                        <!-- logged out -->
                        <Button x:Name="AccountMenuButton"
                                Content="Anmelden"
                                Style="{StaticResource SecondaryButton}"
                                Click="AccountButton_Click"
                                Height="40"
                                HorizontalContentAlignment="Center" />

                        <!-- logged in -->
                        <Border x:Name="UserProfileCornerBox"
                                CornerRadius="12"
                                Padding="12"
                                Cursor="Hand"
                                AutomationProperties.Name="Kontoeinstellungen"
                                MouseLeftButtonDown="UserProfileCornerBox_Click"
                                Visibility="Collapsed"
                                ToolTip="Kontoeinstellungen">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#17253E" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1F3253" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CornerAvatarBox" Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                                    <TextBlock x:Name="CornerAvatarText" Text="?" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CornerUsernameText" Text="Username" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CornerRoleText" Text="Rolle: USER" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Separator Grid.Row="1" Style="{StaticResource ModernSeparator}" />

                    <!-- Navigation -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Top">

                        <Button x:Name="NavHomeButton" AutomationProperties.Name="Home" Style="{StaticResource NavButton}" Click="HomeButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavHomeIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,13,0" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Style="{StaticResource NavIcon}" Data="M2.2,7.3 L8,2.2 L13.8,7.3 L13.8,13.8 L2.2,13.8 Z M6.5,13.8 L6.5,9.4 L9.5,9.4 L9.5,13.8" />
                                <TextBlock Grid.Column="2" Text="Home" Style="{StaticResource NavLabel}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavUpdatesButton" AutomationProperties.Name="Updates" Style="{StaticResource NavButton}" Click="UpdatesButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavUpdatesIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,13,0" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Style="{StaticResource NavIcon}" Data="M8,2.2 L8,10.2 M4.7,7.1 L8,10.5 L11.3,7.1 M2.6,11.6 L2.6,14 L13.4,14 L13.4,11.6" />
                                <TextBlock Grid.Column="2" Text="Updates" Style="{StaticResource NavLabel}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavAccountButton" AutomationProperties.Name="Account" Style="{StaticResource NavButton}" Click="AccountButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavAccountIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,13,0" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Style="{StaticResource NavIcon}" Data="M8,2.4 A2.6,2.6 0 1 1 8,7.6 A2.6,2.6 0 1 1 8,2.4 Z M2.6,14.2 C2.6,10.9 5,9.6 8,9.6 C11,9.6 13.4,10.9 13.4,14.2" />
                                <TextBlock Grid.Column="2" Text="Account" Style="{StaticResource NavLabel}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavAdminButton" AutomationProperties.Name="Admin" Style="{StaticResource NavButton}" Click="AdminButton_Click" Margin="0,0,0,4" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavAdminIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,13,0" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Style="{StaticResource NavIcon}" Data="M8,1.8 L13.4,3.9 L13.4,8 C13.4,11.4 8,14.2 8,14.2 C8,14.2 2.6,11.4 2.6,8 L2.6,3.9 Z" />
                                <TextBlock Grid.Column="2" Text="Admin" Style="{StaticResource NavLabel}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavPerformanceButton" AutomationProperties.Name="Performance" Style="{StaticResource NavButton}" Click="PerformanceButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavPerformanceIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,13,0" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Style="{StaticResource NavIcon}" Data="M1.6,8.2 L4.6,8.2 L6.4,3.4 L9.6,12.6 L11.4,8.2 L14.4,8.2" />
                                <TextBlock Grid.Column="2" Text="Performance" Style="{StaticResource NavLabel}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavCreditsButton" AutomationProperties.Name="Credits" Style="{StaticResource NavButton}" Click="CreditsButton_Click" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavCreditsIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,13,0" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Style="{StaticResource NavIcon}" Data="M8,14.1 C8,14.1 1.7,9.9 1.7,5.9 C1.7,3.4 3.6,1.7 5.8,1.7 C7.1,1.7 7.7,2.5 8,3.2 C8.3,2.5 8.9,1.7 10.2,1.7 C12.4,1.7 14.3,3.4 14.3,5.9 C14.3,9.9 8,14.1 8,14.1 Z" />
                                <TextBlock Grid.Column="2" Text="Credits" Style="{StaticResource NavLabel}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavSettingsButton" AutomationProperties.Name="Einstellungen" Style="{StaticResource NavButton}" Click="SettingsButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavSettingsIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource AccentGradient}" Opacity="0" Margin="0,0,13,0" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Style="{StaticResource NavIcon}" Data="M1.8,4.2 L14.2,4.2 M1.8,8 L14.2,8 M1.8,11.8 L14.2,11.8 M5.4,2.3 A1.9,1.9 0 1 1 5.4,6.1 A1.9,1.9 0 1 1 5.4,2.3 Z M10.4,6.1 A1.9,1.9 0 1 1 10.4,9.9 A1.9,1.9 0 1 1 10.4,6.1 Z M6.9,9.9 A1.9,1.9 0 1 1 6.9,13.7 A1.9,1.9 0 1 1 6.9,9.9 Z" />
                                <TextBlock Grid.Column="2" Text="Einstellungen" Style="{StaticResource NavLabel}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Version / updater -->
                    <Border Grid.Row="3" Style="{StaticResource Card.Sunken}" Padding="13">
                        <StackPanel>
                            <TextBlock x:Name="LauncherVersionText" Text="Version: 1.0.0"
                                       Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="LauncherUpdateStatusText" Text=""
                                       FontSize="11"
                                       Foreground="{StaticResource Success}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,11" />
                            <Button x:Name="CheckLauncherUpdateButton"
                                    Content="Update prüfen"
                                    Style="{StaticResource RowActionButton}"
                                    Click="CheckLauncherUpdateButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Column="1" ClipToBounds="True">

                <!-- ===== ANIMATED BACKDROP ==================================
                     Four aurora blobs drift on independent loops (see the
                     storyboards in Window.Triggers) plus a slow opacity
                     "breathing" pass. Everything is non-interactive and
                     sits behind the cards, so legibility is untouched.
                     ============================================================ -->
                <Grid x:Name="Backdrop" Background="{StaticResource ContentBackground}" IsHitTestVisible="False" Opacity="0">

                    <Ellipse x:Name="AuroraCyanBlob" Width="760" Height="760"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-300,-260,0" Fill="{StaticResource AuroraCyan}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode>
                            <BitmapCache RenderAtScale="1" />
                        </Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraCyanMove" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="AuroraVioletBlob" Width="700" Height="700"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-250,0,0,-280" Fill="{StaticResource AuroraViolet}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode>
                            <BitmapCache RenderAtScale="1" />
                        </Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraVioletMove" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="AuroraMagentaBlob" Width="620" Height="620"
                             HorizontalAlignment="Center" VerticalAlignment="Top"
                             Margin="0,-380,0,0" Fill="{StaticResource AuroraMagenta}"
                             Opacity="0.75"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode>
                            <BitmapCache RenderAtScale="1" />
                        </Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraMagentaMove" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="AuroraBlueBlob" Width="900" Height="900"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom"
                             Margin="0,0,0,-420" Fill="{StaticResource AuroraBlue}"
                             Opacity="0.6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode>
                            <BitmapCache RenderAtScale="1" />
                        </Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraBlueMove" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Rectangle Fill="{StaticResource BackdropVignette}" />
                </Grid>

                <Grid Margin="36,28,36,28">

                    <!-- ============ HOME ============ -->
                    <Grid x:Name="HomePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,26">
                            <Image x:Name="HeroLogoImage"
                                   Source="pack://application:,,,/Assets/logo.png"
                                   Height="92" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,20"
                                   Opacity="0" RenderTransformOrigin="0.5,0.5"
                                   AutomationProperties.Name="RFG Logo">
                                <Image.Effect>
                                    <DropShadowEffect Color="#22D3EE" BlurRadius="34" ShadowDepth="0" Opacity="0.45" />
                                </Image.Effect>
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="HeroLogoScale" ScaleX="0.86" ScaleY="0.86" />
                                        <TranslateTransform x:Name="HeroLogoSlide" Y="46" />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <TextBlock x:Name="HeroTitleText" Text="Realistic Funfair Games" Style="{StaticResource Text.Display}" Opacity="0" />
                            <TextBlock x:Name="HeroSubtitleText" Text="Kirmes Beta Launcher  ·  Installation, Zugriff und Spielstart an einem Ort"
                                       Style="{StaticResource Text.Body}" Margin="0,7,0,0" Opacity="0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Stretch">

                            <!-- stat tiles -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="StatTileVersion" Grid.Column="0" Style="{StaticResource Card}" Padding="16" Opacity="0">
                                    <StackPanel>
                                        <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource GhostSurface}" HorizontalAlignment="Left">
                                            <Path Style="{StaticResource Icon}" Data="M4.8,2.6 L11.2,2.6 L12.6,4 L12.6,13.4 L3.4,13.4 L3.4,3.6 L4.8,3.6 Z" Width="16" Height="16" />
                                        </Border>
                                        <TextBlock Text="SPIELVERSION" Style="{StaticResource Text.StatLabel}" Margin="0,13,0,0" />
                                        <TextBlock x:Name="HomeVersionText" Text="Version wird geladen..." Style="{StaticResource Text.StatValue}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="StatTileStatus" Grid.Column="2" Style="{StaticResource Card}" Padding="16" Opacity="0">
                                    <StackPanel>
                                        <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource GhostSurface}" HorizontalAlignment="Left">
                                            <Path Style="{StaticResource Icon}" Data="M8,1.8 A6.2,6.2 0 1 1 8,14.2 A6.2,6.2 0 1 1 8,1.8 Z M5.2,8.1 L7.1,10 L10.9,6.1" Width="16" Height="16" />
                                        </Border>
                                        <TextBlock Text="SPIELSTATUS" Style="{StaticResource Text.StatLabel}" Margin="0,13,0,0" />
                                        <TextBlock x:Name="HomeStatusText" Text="PRÜFE..." Style="{StaticResource Text.StatValue}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="StatTileBeta" Grid.Column="4" Style="{StaticResource Card}" Padding="16" Opacity="0">
                                    <StackPanel>
                                        <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource GhostSurface}" HorizontalAlignment="Left">
                                            <Path Style="{StaticResource Icon}" Data="M8,1.8 L13.4,3.9 L13.4,8 C13.4,11.4 8,14.2 8,14.2 C8,14.2 2.6,11.4 2.6,8 L2.6,3.9 Z M5.9,8.1 L7.4,9.7 L10.3,6.5" Width="16" Height="16" />
