<Window x:Class="BetaLauncher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher Update" Height="180" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Lade Launcher-Update herunter..." 
                       Foreground="White" FontSize="14" FontWeight="SemiBold" 
                       Margin="0,0,0,10"/>
            <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0" Maximum="100" 
                         Background="#1E293B" Foreground="#38BDF8"/>
            <TextBlock x:Name="PercentageText" Text="0%" 
                       Foreground="#94A3B8" FontSize="12" 
                       HorizontalAlignment="Right" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
