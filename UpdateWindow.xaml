<Window x:Class="BetaLauncher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher Update" Height="210" Width="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma"
        ShowInTaskbar="False">
    <Border Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="30" Height="30" CornerRadius="10" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                    <Path Data="M0,0 L11,0 L5.5,6 Z" Fill="#FFFFFF" Width="12" Height="7" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Launcher wird aktualisiert" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Content="Abbrechen" Style="{StaticResource QuietButton}" Click="CloseButton_Click"
                        Margin="10,0,0,0" Padding="10,4" FontSize="11.5" VerticalAlignment="Center"
                        ToolTip="Update abbrechen" />
            </StackPanel>

            <ProgressBar x:Name="ProgressBar" Grid.Row="1" Style="{StaticResource ModernProgressBar}"
                         Height="10" Minimum="0" Maximum="100" />

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" Text="Lade Launcher-Update herunter..."
                           Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <TextBlock x:Name="PercentageText" Text="0%"
                           Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>
